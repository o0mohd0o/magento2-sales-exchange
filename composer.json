{
    "name": "bonlineco/module-sales-exchange",
    "description": "Admin-first exchange order workflow for Magento Open Source",
    "type": "magento2-module",
    "version": "0.2.4",
    "license": "MIT",
    "keywords": [
        "exchange order",
        "magento2",
        "product exchange",
        "replacement order",
        "returns"
    ],
    "authors": [
        {
            "name": "Bonlineco",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        }
    ],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-bcmath": "*",
        "magento/framework": "^103.0.6",
        "magento/module-backend": "^102.0.6",
        "magento/module-catalog": "^104.0.6",
        "magento/module-config": "^101.2.6",
        "magento/module-directory": "^100.4.6",
        "magento/module-payment": "^100.4.6",
        "magento/module-quote": "^101.2.6",
        "magento/module-sales": "^103.0.6",
        "magento/module-sales-inventory": "^100.4.3",
        "magento/module-shipping": "^100.4.6",
        "magento/module-store": "^101.1.6",
        "magento/module-tax": "^100.4.6",
        "magento/module-ui": "^101.2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^12.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false
        }
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Bonlineco\\SalesExchange\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bonlineco\\SalesExchange\\Test\\": "Test/"
        }
    },
    "archive": {
        "exclude": [
            "/.DS_Store",
            "/.env",
            "/.env.*",
            "/.github",
            "/.gitattributes",
            "/.gitignore",
            "/.idea",
            "/.phpcs.xml.dist",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/.vscode",
            "/Test",
            "/auth.json",
            "/build",
            "/composer.lock",
            "/coverage",
            "/dev",
            "/docs",
            "/vendor"
        ]
    }
}
